# Database Configuration
# (DATABASE_URL is not read by the code -- config/database.ts uses the discrete DB_* vars below)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mindmend
DB_USER=your_db_user
DB_PASSWORD=your_db_password
# Set DB_SSL=true when connecting to a hosted Postgres (Neon, Render, etc.) that requires SSL
DB_SSL=false

# Server Configuration
PORT=3001
NODE_ENV=development

# JWT Secret -- generate a strong random value in production, e.g.: openssl rand -hex 32
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here

# CORS Configuration (your frontend URL)
FRONTEND_URL=http://localhost:5173

# Session Configuration
SESSION_EXPIRY=7d
